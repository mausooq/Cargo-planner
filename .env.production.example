# Copy to .env.production on the server and fill in. Never commit .env.production.

# Required. A long random secret that signs sign-in sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-output-of-openssl-rand"

# Lets sign-in work at whatever address people use (IP, hostname, or a proxy domain).
AUTH_TRUST_HOST="true"

# Optional: set only if everyone uses one fixed address, e.g. behind a reverse proxy with HTTPS.
# AUTH_URL="https://compass.example.com"

# Leave demo accounts hidden in production. Set to 1 only for a private trial.
# COMPASS_DEMO_LOGIN="1"
