# Copy to .env.production on the server and fill in. Never commit .env.production.

# Required. A long random secret that signs sign-in sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-output-of-openssl-rand"

# Lets sign-in work at whatever address people use (IP, hostname, or a proxy domain).
AUTH_TRUST_HOST="true"

# Optional: the address the domain proxy answers on (docker compose --profile domain up -d).
#   ":80"                               any name or IP, plain HTTP, no ":3000" needed
#   "http://compass.yourcompany.local"  an internal name, plain HTTP
#   "compass.yourcompany.com"           a public name with automatic HTTPS
# COMPASS_SITE_ADDRESS=":80"

# Optional: set only if everyone uses one fixed address, e.g. the domain above.
# AUTH_URL="https://compass.example.com"

# Optional: lets planners drop a photo or PDF of a packing list and have Compass fill in the cargo.
# The file is sent to Claude (Anthropic) to be read. Get a key at https://platform.claude.com.
# Without it, Excel and CSV import still work. The server needs internet access to api.anthropic.com.
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional: which Claude model reads the documents (default: claude-sonnet-5-5).
# COMPASS_AI_MODEL="claude-sonnet-5-5"

# Leave demo accounts hidden in production. Set to 1 only for a private trial.
# COMPASS_DEMO_LOGIN="1"
