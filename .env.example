DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Optional: reading packing lists with AI (photos, PDFs, pasted text, unstructured sheets) ---
# Excel and CSV packing lists import by column and never need these.
# The key stays on the server. Never put it in a NEXT_PUBLIC_ variable and never commit it.
# ANTHROPIC_API_KEY=""
# Which provider reads documents. Only "anthropic" exists today; an internal model can be added later.
# COMPASS_AI_PROVIDER="anthropic"
# The Claude model used for reading. Must accept text, images and PDFs.
# COMPASS_AI_MODEL="claude-sonnet-5-5"
# Milliseconds to wait for one reading (default 120000), and the most PDF pages accepted at once (default 30).
# COMPASS_AI_TIMEOUT_MS="120000"
# COMPASS_AI_MAX_PDF_PAGES="30"
